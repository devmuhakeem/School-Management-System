# ==============================================================================
# SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and populate with your environment secrets.
# NEVER commit real passwords, secret keys, or credentials to version control.
# ==============================================================================

# Core Application Environment
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# AI Studio injected runtime configuration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL + Prisma)
# ------------------------------------------------------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_management?schema=public"
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/school_management?schema=public"
DATABASE_POOL_SIZE=10
DATABASE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARACTERS_REQUIRED"
AUTH_EXPIRY="7d"
AUTH_REFRESH_EXPIRY="30d"
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 3. OBJECT STORAGE (S3-Compatible / Cloud Storage)
# ------------------------------------------------------------------------------
STORAGE_DRIVER="local" # "local" | "s3" | "gcs"
STORAGE_BUCKET="sms-school-documents"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_ACCESS_KEY_ID="STORAGE_ACCESS_KEY"
STORAGE_SECRET_ACCESS_KEY="STORAGE_SECRET_KEY"

# ------------------------------------------------------------------------------
# 4. EMAIL SERVICE (SMTP / SendGrid / Postmark)
# ------------------------------------------------------------------------------
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="smtp_user"
SMTP_PASSWORD="smtp_password"
SMTP_FROM_NAME="School Management System"
SMTP_FROM_EMAIL="noreply@school.edu"

# ------------------------------------------------------------------------------
# 5. NOTIFICATION & SMS SERVICE
# ------------------------------------------------------------------------------
SMS_PROVIDER="twilio" # "twilio" | "aws_sns" | "mock"
SMS_ACCOUNT_SID="AC_TWILIO_ACCOUNT_SID"
SMS_AUTH_TOKEN="TWILIO_AUTH_TOKEN"
SMS_SENDER_ID="SchoolAlert"

# ------------------------------------------------------------------------------
# 6. SYSTEM LOGGING & MONITORING
# ------------------------------------------------------------------------------
LOG_LEVEL="info" # "debug" | "info" | "warn" | "error"
ENABLE_AUDIT_LOGGING=true
