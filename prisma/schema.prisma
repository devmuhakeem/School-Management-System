// ==============================================================================
// SCHOOL MANAGEMENT SYSTEM (SchoolOS) — PRISMA ORM SCHEMA
// PHASE 2: Comprehensive Multi-Tenant Core Domain Model
// Supports: Multi-Tenancy, Campuses, Identity, RBAC, Academic Structure,
//           Students, Enrollments, Guardians, Staff, Departments, Positions,
//           Teaching Assignments, Attendance, Notifications, Files, and Auditing.
// ==============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

